# /etc/default/raspi-media-player
RASPI_MEDIA_PLAYER_ADDR=0.0.0.0:8080
RASPI_MEDIA_PLAYER_DB=/var/lib/raspi-media-player/player.sqlite
RASPI_MEDIA_PLAYER_LOG_FORMAT=json
RASPI_MEDIA_PLAYER_LOG_LEVEL=info
RASPI_MEDIA_PLAYER_LOG_FILE=/var/log/raspi-media-player.log
RASPI_MEDIA_PLAYER_QUEUE_LIMIT=100
RASPI_MEDIA_PLAYER_QUEUE_RATE=20
