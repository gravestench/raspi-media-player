# /etc/default/raspi-media-player
RASPI_MEDIA_PLAYER_ADDR=0.0.0.0:8080
RASPI_MEDIA_PLAYER_DB=/var/lib/raspi-media-player/player.sqlite
RASPI_MEDIA_PLAYER_LOG_FORMAT=json
RASPI_MEDIA_PLAYER_LOG_LEVEL=info
RASPI_MEDIA_PLAYER_LOG_FILE=/var/log/raspi-media-player.log
RASPI_MEDIA_PLAYER_QUEUE_LIMIT=100
RASPI_MEDIA_PLAYER_QUEUE_RATE=20
RASPI_MEDIA_PLAYER_ACCESS_MODE=open
RASPI_MEDIA_PLAYER_AUTH_RATE=10
RASPI_MEDIA_PLAYER_SESSION_DAYS=30
RASPI_MEDIA_PLAYER_SECURE_COOKIE=false
RASPI_MEDIA_PLAYER_ARGON_MEMORY_KIB=65536
RASPI_MEDIA_PLAYER_ARGON_ITERATIONS=3
RASPI_MEDIA_PLAYER_PLAYER_ENABLED=true
RASPI_MEDIA_PLAYER_PLAYER_BACKEND=mpv
RASPI_MEDIA_PLAYER_MPV_BINARY=/usr/bin/mpv
RASPI_MEDIA_PLAYER_MPV_SOCKET=/var/lib/raspi-media-player/mpv.sock
RASPI_MEDIA_PLAYER_AUDIO_DEVICE=alsa/plughw:CARD=Headphones,DEV=0
RASPI_MEDIA_PLAYER_CACHE_SECONDS=20
RASPI_MEDIA_PLAYER_PLAYER_RETRIES=1
RASPI_MEDIA_PLAYER_HISTORY_DAYS=90
# Optional read-only artist metadata enrichment. Keep the real value only in
# /etc/default/raspi-media-player; deployment upgrades preserve that file.
RASPI_MEDIA_PLAYER_LASTFM_API_KEY=
RASPI_MEDIA_PLAYER_METADATA_ENABLED=true
RASPI_MEDIA_PLAYER_METADATA_CACHE_DAYS=7
RASPI_MEDIA_PLAYER_METADATA_USER_AGENT='raspi-media-player/0.1 (https://github.com/dylanknuth/raspi-media-player)'
RASPI_MEDIA_PLAYER_METADATA_IMAGE_DIR=/var/lib/raspi-media-player/artist-images
RASPI_MEDIA_PLAYER_METADATA_MAX_INFLIGHT=2
RASPI_MEDIA_PLAYER_SETUP_REQUIRED=true
# Generate a long random value during first installation. Required before API
# keys can be saved through the administrator UI.
RASPI_MEDIA_PLAYER_SETTINGS_SECRET_KEY=
