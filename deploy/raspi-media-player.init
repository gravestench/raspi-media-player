#!/bin/sh
### BEGIN INIT INFO
# Provides:          raspi-media-player
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Household Raspberry Pi jukebox
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
NAME=raspi-media-player
DAEMON=/usr/local/bin/raspi-media-player
DESC="Raspberry Pi household jukebox"
PIDFILE=/run/$NAME.pid
DEFAULTS=/etc/default/$NAME
USER=raspi-media-player

[ -r "$DEFAULTS" ] && . "$DEFAULTS"
[ -x "$DAEMON" ] || exit 0

. /lib/lsb/init-functions

case "$1" in
  start)
    log_daemon_msg "Starting $DESC" "$NAME"
    start-stop-daemon --start --quiet --background --make-pidfile \
      --pidfile "$PIDFILE" --chuid "$USER" --chdir /var/lib/raspi-media-player \
      --output "${RASPI_MEDIA_PLAYER_LOG_FILE:-/var/log/raspi-media-player.log}" \
      --exec "$DAEMON" -- \
      -addr "${RASPI_MEDIA_PLAYER_ADDR:-0.0.0.0:8080}" \
      -db "${RASPI_MEDIA_PLAYER_DB:-/var/lib/raspi-media-player/player.sqlite}" \
      -log-format "${RASPI_MEDIA_PLAYER_LOG_FORMAT:-json}" \
      -log-level "${RASPI_MEDIA_PLAYER_LOG_LEVEL:-info}" \
      -queue-limit "${RASPI_MEDIA_PLAYER_QUEUE_LIMIT:-100}" \
      -queue-rate "${RASPI_MEDIA_PLAYER_QUEUE_RATE:-20}" \
      -access-mode "${RASPI_MEDIA_PLAYER_ACCESS_MODE:-open}" \
      -auth-rate "${RASPI_MEDIA_PLAYER_AUTH_RATE:-10}" \
      -session-days "${RASPI_MEDIA_PLAYER_SESSION_DAYS:-30}" \
      -secure-cookie="${RASPI_MEDIA_PLAYER_SECURE_COOKIE:-false}" \
      -argon-memory "${RASPI_MEDIA_PLAYER_ARGON_MEMORY_KIB:-65536}" \
      -argon-iterations "${RASPI_MEDIA_PLAYER_ARGON_ITERATIONS:-3}" \
      -player-enabled="${RASPI_MEDIA_PLAYER_PLAYER_ENABLED:-true}" \
      -player-backend "${RASPI_MEDIA_PLAYER_PLAYER_BACKEND:-mpv}" \
      -mpv-binary "${RASPI_MEDIA_PLAYER_MPV_BINARY:-/usr/bin/mpv}" \
      -mpv-socket "${RASPI_MEDIA_PLAYER_MPV_SOCKET:-/var/lib/raspi-media-player/mpv.sock}" \
      -audio-device "${RASPI_MEDIA_PLAYER_AUDIO_DEVICE:-auto}" \
      -cache-seconds "${RASPI_MEDIA_PLAYER_CACHE_SECONDS:-20}" \
      -player-retries "${RASPI_MEDIA_PLAYER_PLAYER_RETRIES:-1}"
    log_end_msg $?
    ;;
  stop)
    log_daemon_msg "Stopping $DESC" "$NAME"
    start-stop-daemon --stop --quiet --retry=TERM/10/KILL/5 --pidfile "$PIDFILE"
    result=$?
    rm -f "$PIDFILE"
    log_end_msg $result
    ;;
  restart|force-reload)
    "$0" stop
    "$0" start
    ;;
  status)
    status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME"
    exit $?
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
    exit 2
    ;;
esac
