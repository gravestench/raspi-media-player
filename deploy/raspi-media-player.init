#!/bin/sh
### BEGIN INIT INFO
# Provides:          raspi-media-player
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Household Raspberry Pi jukebox
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
NAME=raspi-media-player
DAEMON=/usr/local/bin/raspi-media-player
DESC="Raspberry Pi household jukebox"
PIDFILE=/run/$NAME.pid
DEFAULTS=/etc/default/$NAME
USER=raspi-media-player

[ -r "$DEFAULTS" ] && . "$DEFAULTS"
[ -x "$DAEMON" ] || exit 0

. /lib/lsb/init-functions

case "$1" in
  start)
    log_daemon_msg "Starting $DESC" "$NAME"
    start-stop-daemon --start --quiet --background --make-pidfile \
      --pidfile "$PIDFILE" --chuid "$USER" --exec "$DAEMON" -- \
      -addr "${RASPI_MEDIA_PLAYER_ADDR:-0.0.0.0:8080}" \
      -db "${RASPI_MEDIA_PLAYER_DB:-/var/lib/raspi-media-player/player.sqlite}" \
      -log-format "${RASPI_MEDIA_PLAYER_LOG_FORMAT:-json}" \
      -log-level "${RASPI_MEDIA_PLAYER_LOG_LEVEL:-info}"
    log_end_msg $?
    ;;
  stop)
    log_daemon_msg "Stopping $DESC" "$NAME"
    start-stop-daemon --stop --quiet --retry=TERM/10/KILL/5 --pidfile "$PIDFILE"
    result=$?
    rm -f "$PIDFILE"
    log_end_msg $result
    ;;
  restart|force-reload)
    "$0" stop
    "$0" start
    ;;
  status)
    status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME"
    exit $?
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
    exit 2
    ;;
esac
